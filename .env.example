# Runtime server
HOST=0.0.0.0
PORT=7890
I_REMEMBER_HOST_PORT=7892
API_HOST=127.0.0.1
API_PORT=7892
API_BASE_URL=http://127.0.0.1:7892

# Production API and embedded database
# Leave empty to generate and persist a random secret in the data volume.
# If supplied, use a strong random value and keep it identical after restore.
AUTH_SECRET=
# Safe only because the built-in web proxy is the API's loopback-only peer.
API_TRUST_PROXY=true
# Enable only when the public web listener is reached through a trusted
# loopback reverse proxy that replaces, rather than appends, forwarding headers.
I_REMEMBER_TRUST_PROXY=false
# Exact IPs or hostnames for trusted container peers; Compose maps this name to
# the Docker host gateway used by the loopback-published port.
I_REMEMBER_TRUSTED_PROXY_PEERS=host.docker.internal
STORAGE_PATH=/var/opt/i-remember.fr/assets
STORAGE_PUBLIC_BASE_URL=/uploads
API_MAX_STANDARD_JSON_BODY_BYTES=262144
# Memory/page transport budget; body text has no character-count limit.
API_MAX_CONTENT_JSON_BODY_BYTES=16777216
API_MAX_ASSET_JSON_BODY_BYTES=12582912
POSTGRES_MAJOR=15
POSTGRES_DB=i_remember
POSTGRES_PORT=5432

# Public site defaults (persisted on first start; later edit Settings > Site)
I_REMEMBER_DATA_DIR=/var/opt/i-remember.fr
I_REMEMBER_SITE_NAME="I remember,"
I_REMEMBER_SITE_TITLE="Songqi Duan | 段松岐"
I_REMEMBER_CANONICAL_URL=https://songqi.org
I_REMEMBER_SITE_DESCRIPTION="A quiet place for the moments we might one day forget."
I_REMEMBER_OWNER_NAME="Songqi Duan"
I_REMEMBER_OWNER_ALTERNATE_NAME="段松岐"
I_REMEMBER_DEFAULT_LANGUAGE=en
I_REMEMBER_ANONYMOUS_SUBMISSIONS=false
I_REMEMBER_MAX_UPLOAD_BYTES=8388608
I_REMEMBER_MAX_IMAGE_PIXELS=64000000

# Self-hosted Umami tracking
UMAMI_SRC=
UMAMI_WEBSITE_ID=

# DockerHub release
DOCKERHUB_IMAGE=zerostwo/i-remember.fr
TAG=sha-replace-with-12-character-commit
