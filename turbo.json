{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "@i-remember/database#typecheck": {
      "dependsOn": ["build"]
    },
    "@i-remember/api#test": {
      "dependsOn": ["build"]
    }
  }
}
